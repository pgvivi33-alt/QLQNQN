{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "An AI prompt item stored in the beginner prompt vault.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The prompt title.",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "The prompt category.",
          "enum": ["사진 합성", "스타일 변환", "캐릭터·포스터"],
          "minLength": 1,
          "maxLength": 50
        },
        "content": {
          "type": "string",
          "description": "The full prompt body text including line breaks and formatting.",
          "minLength": 1,
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the prompt was created."
        }
      },
      "required": ["title", "category", "content", "createdAt"]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": {
        "$ref": "#/entities/Prompt"
      },
      "description": "Collection of AI prompts publicly readable by guests and writable only by the admin."
    }
  }
}
